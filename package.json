    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@logtail/node": "^0.5.8",
    "@logtail/winston": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
