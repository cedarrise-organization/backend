meta {
  name: Get full registration detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/forms/ash/registration/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: a91fe955-0316-43b8-bc0b-0a5c75f589c5
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get Full ASH Registration Detail
  
  Retrieves the complete detail of a single ASH student registration by its unique identifier. Returns all student bio-data, academic information, parental/guardian contacts, household details, file URLs, and administrative fields.
  
  ## Authorization
  Requires `read` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                              |
  |-----------|--------|----------|------------------------------------------|
  | id        | string | Yes      | UUID of the ASH student registration     |
  
  ## Response
  
  **`200 OK`** — Returns the complete ASH student registration record including all uploaded file URLs.
  
  ```json
  {
    "success": true,
    "message": "...",
    "data": {
      "id": "uuid",
      "programType": "string",
      "firstName": "string",
      "middleName": "string" | null,
      "surname": "string",
      "gender": "MALE | FEMALE",
      "age": 12,
      "dob": "YYYY-MM-DD",
      "primaryLanguage": "string",
      "homeAddress": "string",
      "studentPhone": "string" | null,
      "passportPhotoUrl": "string",
      "passportPhotoPublicId": "string",
      "schoolName": "string",
      "schoolTown": "string",
      "schoolLga": "string",
      "schoolState": "string",
      "currentClass": "string",
      "classPositionLastTerm": "string",
      "lastResultUrl": "string" | null,
      "lastResultPublicId": "string" | null,
      "prevAfterschoolProgram": "string",
      "reasonForJoining": "string",
      "fathersName": "string",
      "fathersPhone": "string" | null,
      "fathersOccupation": "string",
      "mothersName": "string",
      "mothersPhone": "string",
      "mothersOccupation": "string" | null,
      "guardianName": "string" | null,
      "guardianRelationship": "string" | null,
      "guardianPhone": "string" | null,
      "guardianOccupation": "string" | null,
      "householdIncomeRange": "string" | null,
      "hasLearningCondition": "string",
      "learningConditions": ["string"] | null,
      "parentConsent": true,
      "declarationConfirmed": true,
      "parentSignatureUrl": "string",
      "parentSignaturePublicId": "string",
      "assignedMentor": "string" | null,
      "pretestScore": 75.5 | null,
      "status": "pending | accepted | rejected",
      "updatedAt": "ISO 8601" | null,
      "createdAt": "ISO 8601",
      "deletedAt": "ISO 8601" | null
    }
  }
  ```
  
  ### Response Fields (`data`)
  
  | Field                    | Type     | Description                                                         |
  |--------------------------|----------|---------------------------------------------------------------------|
  | id                       | string   | UUID primary key.                                                   |
  | programType              | string   | Type of ASH programme.                                              |
  | firstName                | string   | Student's first name.                                               |
  | middleName               | string   | Student's middle name (nullable).                                   |
  | surname                  | string   | Student's surname.                                                  |
  | gender                   | string   | Student's gender (`MALE` or `FEMALE`).                              |
  | age                      | number   | Student's age (6–18).                                               |
  | dob                      | string   | Date of birth (`YYYY-MM-DD`).                                       |
  | primaryLanguage          | string   | Student's primary language.                                         |
  | homeAddress              | string   | Student's home address.                                             |
  | studentPhone             | string   | Student's phone number (nullable).                                  |
  | passportPhotoUrl         | string   | URL of the student's passport photograph.                           |
  | passportPhotoPublicId    | string   | Cloudinary public ID for the passport photo.                        |
  | schoolName               | string   | Name of the student's school.                                       |
  | schoolTown               | string   | Town where the school is located.                                   |
  | schoolLga                | string   | LGA of the school.                                                  |
  | schoolState              | string   | State where the school is located.                                  |
  | currentClass             | string   | Student's current class/grade.                                      |
  | classPositionLastTerm    | string   | Student's class position last term.                                 |
  | lastResultUrl            | string   | URL of the student's last result (nullable).                        |
  | lastResultPublicId       | string   | Cloudinary public ID for the last result (nullable).                |
  | prevAfterschoolProgram   | string   | Previous after-school programme participation.                      |
  | reasonForJoining         | string   | Reason for joining the ASH programme.                               |
  | fathersName              | string   | Father's full name.                                                 |
  | fathersPhone             | string   | Father's phone number (nullable).                                   |
  | fathersOccupation        | string   | Father's occupation.                                                |
  | mothersName              | string   | Mother's full name.                                                 |
  | mothersPhone             | string   | Mother's phone number.                                              |
  | mothersOccupation        | string   | Mother's occupation (nullable).                                     |
  | guardianName             | string   | Guardian's full name (nullable).                                    |
  | guardianRelationship     | string   | Guardian's relationship to the student (nullable).                  |
  | guardianPhone            | string   | Guardian's phone number (nullable).                                 |
  | guardianOccupation       | string   | Guardian's occupation (nullable).                                   |
  | householdIncomeRange     | string   | Household income range (nullable).                                  |
  | hasLearningCondition     | string   | Whether the student has a learning condition.                       |
  | learningConditions       | string[] | List of learning conditions (nullable).                             |
  | parentConsent            | boolean  | Whether parent consent was given.                                   |
  | declarationConfirmed     | boolean  | Whether the declaration was confirmed.                              |
  | parentSignatureUrl       | string   | URL of the parent's signature image.                                |
  | parentSignaturePublicId  | string   | Cloudinary public ID for the parent signature.                      |
  | assignedMentor           | string   | Name of the assigned mentor (nullable).                             |
  | pretestScore             | number   | Pre-test score (nullable).                                          |
  | status                   | string   | Registration status (`pending`, `accepted`, `rejected`).            |
  | updatedAt                | string   | ISO 8601 timestamp of last update (nullable).                       |
  | createdAt                | string   | ISO 8601 timestamp of record creation.                              |
  | deletedAt                | string   | ISO 8601 soft-delete timestamp (nullable).                          |
  
  ## Errors
  
  | Status                      | Description                                             |
  |-----------------------------|---------------------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format (must be a valid UUID).             |
  | `500 Internal Server Error` | Unexpected server error.                                |
}
