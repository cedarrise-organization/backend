meta {
  name: Get ASH feedback detail
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/forms/ash/feedback/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: 843e2b52-1d43-44f7-af9d-22d8d0bf59ba
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get ASH Feedback Detail
  
  Retrieves the full detail of a single ASH programme feedback submission by its unique identifier.
  
  ## Authorization
  Requires `read` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                        |
  |-----------|--------|----------|------------------------------------|
  | id        | string | Yes      | UUID of the feedback submission    |
  
  ## Response
  
  **`200 OK`** — Returns the complete ASH feedback record.
  
  ```json
  {
    "success": true,
    "message": "...",
    "data": {
      "id": "uuid",
      "studentFirstName": "string",
      "studentSurname": "string",
      "schoolName": "string",
      "currentClass": "string",
      "attendanceFrequency": "string",
      "enjoyedParts": ["string"] | null,
      "learningImprovementRating": 4,
      "confidenceRating": 3,
      "volunteerSupportRating": 5,
      "studentEnjoyedMost": "string" | null,
      "studentImprovementSuggestions": "string" | null,
      "parentGuardianName": "string",
      "parentGuardianRelationship": "string",
      "parentPhone": "string" | null,
      "childBenefited": "string",
      "academicImprovementNoticed": "string" | null,
      "confidenceBehaviorChange": "string" | null,
      "mostValuableAspects": ["string"] | null,
      "parentSatisfactionRating": 4 | null,
      "programImpactOnChild": "string" | null,
      "parentImprovementSuggestions": "string" | null,
      "additionalComments": "string" | null,
      "updatedAt": "ISO 8601" | null,
      "createdAt": "ISO 8601",
      "deletedAt": "ISO 8601" | null
    }
  }
  ```
  
  ### Response Fields (`data`)
  
  | Field                          | Type     | Description                                                       |
  |--------------------------------|----------|-------------------------------------------------------------------|
  | id                             | string   | UUID primary key.                                                 |
  | studentFirstName               | string   | Student's first name.                                             |
  | studentSurname                 | string   | Student's surname.                                                |
  | schoolName                     | string   | Name of the student's school.                                     |
  | currentClass                   | string   | Student's current class/grade.                                    |
  | attendanceFrequency            | string   | How often the student attends the programme.                      |
  | enjoyedParts                   | string[] | Parts of the programme the student enjoyed (nullable).            |
  | learningImprovementRating      | number   | Rating of learning improvement (1–5).                             |
  | confidenceRating               | number   | Rating of confidence gained (1–5).                                |
  | volunteerSupportRating         | number   | Rating of volunteer support quality (1–5).                        |
  | studentEnjoyedMost             | string   | What the student enjoyed most (nullable).                         |
  | studentImprovementSuggestions  | string   | Student's suggestions for improvement (nullable).                 |
  | parentGuardianName             | string   | Parent/guardian's full name.                                      |
  | parentGuardianRelationship     | string   | Relationship to the student.                                      |
  | parentPhone                    | string   | Parent/guardian phone number (nullable).                           |
  | childBenefited                 | string   | Whether the child benefited from the programme.                   |
  | academicImprovementNoticed     | string   | Academic improvement noticed by parent (nullable).                |
  | confidenceBehaviorChange       | string   | Confidence/behaviour changes noticed (nullable).                  |
  | mostValuableAspects            | string[] | Most valuable aspects of the programme (nullable).                |
  | parentSatisfactionRating       | number   | Parent satisfaction rating (1–5, nullable).                       |
  | programImpactOnChild           | string   | Description of programme impact on the child (nullable).          |
  | parentImprovementSuggestions   | string   | Parent's suggestions for improvement (nullable).                  |
  | additionalComments             | string   | Any additional comments (nullable).                               |
  | updatedAt                      | string   | ISO 8601 timestamp of last update (nullable).                     |
  | createdAt                      | string   | ISO 8601 timestamp of record creation.                            |
  | deletedAt                      | string   | ISO 8601 soft-delete timestamp (nullable).                        |
  
  ## Errors
  
  | Status                      | Description                                             |
  |-----------------------------|---------------------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format (must be a valid UUID).             |
  | `500 Internal Server Error` | Unexpected server error.                                |
}
