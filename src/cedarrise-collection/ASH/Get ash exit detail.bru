  url: {{baseUrl}}/api/v1/forms/ash/exit/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: 7f229c5e-7619-4522-9f6c-b8e383f7d0d7
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get ASH Exit Detail
  
  Retrieves the full detail of a single ASH exit record by its unique identifier.
  
  ## Authorization
  Requires `read` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                |
  |-----------|--------|----------|----------------------------|
  | id        | string | Yes      | UUID of the exit record    |
  
  ## Response
  
  **`200 OK`** — Returns the complete ASH exit record.
  
  ## Errors
  
  | Status                      | Description                                 |
  |-----------------------------|---------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format (must be a valid UUID). |
  | `500 Internal Server Error` | Unexpected server error.                    |
}
