meta {
  name: Download ASH weekly attendance
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/v1/forms/ash/download/ashattendance
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Download ASH Weekly Attendance (CSV Export)
  
  Exports the entire `ash_weekly_attendance` table as a CSV file download. Selects all rows from the table (no filters, no pagination) and converts the records to CSV using json2csv, and returns the CSV as raw file bytes with Content-Type: text/csv and Content-Disposition: attachment. The response is not JSON; frontend clients should read it as a Blob and trigger a browser download.
  ## Authorization
  Requires authentication (`authenticate()`) and `"read"` permission (`authorize("read")`).
  
  ## Request
  No path parameters, query parameters, or request body.
  
  ## Response — `200 OK`
  
  **Content-Type:** `text/csv; charset=utf-8`
  **Content-Disposition:** `attachment; filename="ash_weekly_attendance.csv"`
  
  The CSV contains one row per weekly attendance record with the following columns (in order):
  
  | Column | Description |
  |--------|-------------|
  | `id` | UUID primary key |
  | `sessionDate` | Date the ASH session was held |
  | `studentsInAttendance` | Array of student IDs who attended the session |
  | `studentsMentored` | Number of students mentored during the session |
  | `sessionsConducted` | Number of sessions conducted |
  | `sessionDetails` | Description of activities conducted during the session |
  | `volunteersInAttendance` | Number of volunteers present |
  | `programReview` | Summary review of the programme session |
  | `updatedAt` | Last update timestamp |
  | `createdAt` | Creation timestamp |
  | `deletedAt` | Soft-delete timestamp (null if active) |
  
  ## Errors
  
  | Status | Description |
  |--------|-------------|
  | `401 Unauthorized` | Missing or invalid access token / refresh token. |
  | `403 Forbidden` | User lacks the `"read"` permission. |
  | `500 Internal Server Error` | Unexpected server error. |
}
