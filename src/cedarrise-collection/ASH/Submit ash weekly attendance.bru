meta {
  name: Submit ASH weekly attendance
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/forms/ash/attendance
  body: json
  auth: inherit
}

body:json {
  {
    "sessionDate": "2026-05-28",
    "studentsInAttendance": ["8d9d02ef-fd6d-4cc4-953c-147037e7b290"],
    "studentsMentored": ["8d9d02ef-fd6d-4cc4-953c-147037e7b290"],
    "sessionsConducted": ["PERFORMANCE ART", "FORMATIVE TALKS"],
