}

get {
  url: {{baseUrl}}/api/v1/forms/ash/attendance?page=&limit=&search=
  body: none
  auth: inherit
}

params:query {
  page: 
  limit: 
  search: 
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List ASH Weekly Attendance Records
  
  Returns a paginated list of ASH weekly attendance records, ordered by creation date. Supports full-text search via PostgreSQL GIN index.
  
  ## Authorization
  Requires `read` permission.
  
  ## Query Parameters
  
  | Parameter | Type   | Required | Default | Description                                                                                             |
  |-----------|--------|----------|---------|---------------------------------------------------------------------------------------------------------|
  | page      | number | No       | `1`     | Page number (integer ≥ 1)                                                                               |
  | limit     | number | No       | `25`    | Items per page (integer, 1–100)                                                                         |
  | search    | string | No       | —       | Full-text search query. When provided, cache is bypassed and results are matched against the GIN index. |
  
  ### Searchable Fields
  
  | Field                    | Weight |
  |--------------------------|--------|
  | `sessionsConducted`      | A      |
  
  ## Response
  
  **`200 OK`** — Returns a paginated array of ASH weekly attendance records. Student UUID arrays within each item are resolved to full names via a batch lookup.
  
  ```json
  {
    "success": true,
    "data": [
      {
        "id": "uuid",
        "sessionDate": "YYYY-MM-DD",
        "studentsInAttendance": ["First Surname", "First Surname"],
        "studentsMentored": ["First Surname", "First Surname"],
        "sessionsConducted": ["string"] | null,
        "sessionDetails": "string" | null,
        "volunteersInAttendance": "string",
        "programReview": "string" | null,
        "updatedAt": "ISO 8601" | null,
        "createdAt": "ISO 8601",
        "deletedAt": "ISO 8601" | null
      }
    ],
    "meta": {
      "pagination": {
        "page": 1,
        "limit": 25,
        "totalPages": 1
      }
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                         |
  |-----------------------------|-----------------------------------------------------|
  | `400 Bad Request`           | Invalid query parameters (e.g. non-numeric `page`). |
  | `500 Internal Server Error` | Unexpected server error.                            |
}
