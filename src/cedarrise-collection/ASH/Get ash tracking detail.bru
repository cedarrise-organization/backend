meta {
  name: Get ASH tracking detail
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/forms/ash/tracking/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: c1b068a3-9dc5-4b54-a0f4-1682e6b1fcab
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get ASH Tracking Detail
  
  Retrieves the full detail of a single ASH termly tracking record by its unique identifier.
  
  ## Authorization
  Requires `read` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                              |
  |-----------|--------|----------|------------------------------------------|
  | id        | string | Yes      | UUID of the termly tracking record       |
  
  ## Response
  
  **`200 OK`** — Returns the complete ASH termly tracking record.
  
  ## Errors
  
  | Status                      | Description                                        |
  |-----------------------------|----------------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format (must be a valid UUID).        |
  | `500 Internal Server Error` | Unexpected server error.                           |
}
