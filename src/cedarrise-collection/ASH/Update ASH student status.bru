meta {
  name: Update ASH student status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/forms/ash/registration/{{id}}/status?status=pending
  body: none
  auth: inherit
}

params:query {
  status: pending
}

vars:pre-request {
  baseUrl: http://localhost:3000
  id: 1de0d9d7-5397-4cf4-a114-c577f894fcdd
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Update ASH Student Status
  
  Updates the admin review status of an ASH student registration record. Used to accept, reject, or reset a student application to pending. On status change, all related cache entries (single record and paginated lists) are invalidated.
  
  ## Authorization
  Requires `update` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                          |
  |-----------|--------|----------|--------------------------------------|
  | id        | string | Yes      | UUID of the ASH student record       |
  
  ## Query Parameters
  
  | Parameter | Type   | Required | Default   | Description / Allowed Values                  |
  |-----------|--------|----------|-----------|-----------------------------------------------|
  | status    | string | No       | `pending` | One of: `accepted`, `rejected`, `pending`     |
  
  ## Response
  
  **`200 OK`** — Returns the updated student record with `id` and `status` fields.
  
  ## Errors
  
  | Status                      | Description                                             |
  |-----------------------------|---------------------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format or unknown `status` value.          |
  | `401 Unauthorized`          | Missing or invalid authentication token.                |
  | `403 Forbidden`             | User does not have `update` permission.                 |
  | `500 Internal Server Error` | Unexpected server error.                                |
}
