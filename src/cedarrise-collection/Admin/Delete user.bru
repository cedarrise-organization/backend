meta {
  name: Delete user
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/admin/users/:userId
  body: none
  auth: inherit
}

params:path {
  userId: 5385ec35-3e6a-418d-980c-5ea0ba1a2950
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Delete User
  
  Permanently deletes a user and all associated data (roles, refresh tokens) via cascading deletes.
  
  ## Authorization
  Requires `delete` permission.
  
  ## Path Parameters
  | Parameter | Type   | Required | Description                |
  |-----------|--------|----------|----------------------------|
  | userId    | string | Yes      | UUID of the user to delete |
  
  ## Validation
  - `userId` must be a valid UUID.
  
  ## Response
  
  **`200 OK`** — Returns a success message with no data payload.
  
  ```json
  {
    "success": true,
    "message": "User deleted"
  }
  ```
  
  ## Errors
  - `400 Bad Request` — Invalid `userId` format (must be a valid UUID).
  - `500 Internal Server Error` — User could not be deleted.
}
