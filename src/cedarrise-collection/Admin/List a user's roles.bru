meta {
  name: List a user's roles
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/roles/:userId
  body: none
  auth: inherit
}

params:path {
  userId: 4f0e73b2-586e-4a3c-898f-ced5ffc472da
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get One User's Roles
  
  Retrieves all roles assigned to a specific user.
  
  ## Authorization
  Requires `read` permission.
  
  ## Path Parameters
  | Parameter | Type   | Required | Description                        |
  |-----------|--------|----------|------------------------------------
  | userId    | string | Yes      | UUID of the user to look up roles for |
  
  ## Validation
  - `userId` must be a valid UUID.
  
  ## Response
  
  **`200 OK`** — Returns the list of roles assigned to the specified user.
  
  ```json
  {
    "success": true,
    "message": "Roles for user <userId> found successfully",
    "data": [
      {
        "id": "uuid",
        "name": "volunteer | admin | superadmin",
        "description": "string" | null,
        "isDefault": true | false
      }
    ],
    "meta": {
      "correlationId": "uuid-v4-string"
    }
  }
  ```
  
  > Note: The response only includes `id`, `name`, `description`, and `isDefault` from the roles table (joined via userroles). Timestamps are not returned.
}
