meta {
  name: Assign or Revoke a user's role
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/admin/roles/:userId/action?action=revoke&rolename=superadmin
  body: none
  auth: inherit
}

params:query {
  action: revoke
  rolename: superadmin
}

params:path {
  userId: 6c988057-7d99-4adf-a23f-abe81cea1f0f
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Assign or Revoke a User's Role
  
  Assigns or revokes a role for a specific user.
  
  ## Authorization
  Requires `update` permission.
  
  ## Path Parameters
  | Parameter | Type   | Required | Description                              |
  |-----------|--------|----------|------------------------------------------|
  | userId    | string | Yes      | UUID of the user to modify roles for     |
  
  ## Query Parameters
  | Parameter | Type   | Required | Allowed Values       | Description                          |
  |-----------|--------|----------|----------------------|--------------------------------------|
  | action    | string | Yes      | `assign`, `revoke`   | Whether to assign or revoke the role |
  | rolename  | string | Yes      | `admin`, `superadmin`| The role to assign or revoke         |
  
  ## Validation
  - `userId` must be a valid UUID.
  - `action` must be one of: `assign`, `revoke`.
  - `rolename` must be one of: `admin`, `superadmin`.
  
  ## Response
  
  Both `assign` and `revoke` actions return the same response shape.
  
  ### Assign (`action=assign`)
  
  **`200 OK`** — Confirms the role was assigned. No data payload is returned.
  
  ```json
  {
    "success": true,
    "message": "Role <rolename> assigned successfully",
    "data": null,
    "meta": {
      "correlationId": "uuid-v4-string"
    }
  }
  ```
  
  ### Revoke (`action=revoke`)
  
  **`200 OK`** — Confirms the role was revoked. No data payload is returned.
  
  ```json
  {
    "success": true,
    "message": "Role <rolename> revoked successfully",
    "data": null,
    "meta": {
      "correlationId": "uuid-v4-string"
    }
  }
  ```
}
