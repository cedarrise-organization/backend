meta {
  name: Assign or Revoke a user's role
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/admin/roles/:userId/action?action=assign&rolename=superadmin
  body: none
  auth: inherit
}

params:query {
  action: assign
  rolename: superadmin
}

params:path {
  userId: 302a6bf6-99ea-4162-941b-cb4cb8bb714e
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Assign or Revoke a User's Role
  
  Assigns or revokes a role for a specific user.
  
  ## Authorization
  Requires `update` permission.
  
  ## Path Parameters
  | Parameter | Type   | Required | Description                              |
  |-----------|--------|----------|------------------------------------------|
  | userId    | string | Yes      | UUID of the user to modify roles for     |
  
  ## Query Parameters
  | Parameter | Type   | Required | Allowed Values       | Description                          |
  |-----------|--------|----------|----------------------|--------------------------------------|
  | action    | string | Yes      | `assign`, `revoke`   | Whether to assign or revoke the role |
  | rolename  | string | Yes      | `admin`, `superadmin`| The role to assign or revoke         |
  
  ## Validation
  - `userId` must be a valid UUID.
  - `action` must be one of: `assign`, `revoke`.
  - `rolename` must be one of: `admin`, `superadmin`.
  
  ## Response
  Returns the result of the role action operation.
}
