meta {
  name: List all roles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/roles
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get All Roles
  
  Lists all available roles in the application.
  
  ## Authorization
  Requires `read` permission.
  
  ## Response
  
  **`200 OK`** — Returns an array of role objects.
  
  ```json
  {
    "success": true,
    "message": "Cedarrise App roles found successfully",
    "data": [
      {
        "id": "uuid",
        "name": "volunteer | admin | superadmin",
        "description": "string" | null,
        "isDefault": true | false,
        "updatedAt": "ISO 8601" | null,
        "createdAt": "ISO 8601",
        "deletedAt": "ISO 8601" | null
      }
    ]
  }
  ```
}
