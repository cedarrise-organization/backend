meta {
  name: List all roles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/roles
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: https://backend-69mv.onrender.com
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get All Roles
  
  Lists all available roles and their associated permissions.
  
  ## Authorization
  Requires `read` permission.
  
  ## Response
  Returns an array of role objects, each containing the role name and its permissions.
}
