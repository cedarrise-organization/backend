meta {
  name: List all users
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/users
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List All Users
  
  Lists all registered users in the application. Returns only essential identification fields.
  
  ## Authorization
  Requires `read` permission.
  
  ## Response
  
  **`200 OK`** — Returns an array of user objects.
  
  ```json
  {
    "success": true,
    "message": "All users found successfully",
    "data": [
      {
        "id": "uuid",
        "name": "string",
        "email": "string"
      }
    ]
  }
  ```
  
  > Note: Only `id`, `name`, and `email` are returned. Password, department, and timestamps are excluded from this endpoint.
}
