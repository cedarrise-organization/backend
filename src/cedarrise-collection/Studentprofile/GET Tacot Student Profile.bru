meta {
  name: GET Tacots Student Profile
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/student-profile/tacots/:id
  body: none
  auth: inherit
}

params:path {
  id: f266100b-1510-4793-8531-474023964bb1
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # GET TACOTS Student Profile
  
  Returns the full profile of a TACOTS student by recommendation ID. Aggregates data from `tacots_recommendation`, `tacots_onboarding`, `tacots_tracking`, and `tacots_exit` tables. Tracking and exit queries use the onboarding ID (since both tables reference `tacots_onboarding.id`).
  
  ## Authorization
  Requires authentication and `read` permission.
  
  ## Path Parameters
  
  | Parameter | Type     | Required | Description                                    |
  |-----------|----------|----------|------------------------------------------------|
  | `id`      | `string` | Yes      | UUID of the TACOTS recommendation record.      |
  
  ## Response
  
