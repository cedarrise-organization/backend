  url: {{baseUrl}}/api/v1/volunteer?page=&limit=&orderBy=&status=&sortBy=&search=
  body: none
  auth: inherit
}

params:query {
  page: 
  limit: 
  orderBy: 
  status: 
  sortBy: 
  search: 
}

vars:pre-request {
  baseUrl: http://localhost:3000
  page: 
  status: 
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List All Volunteers
  
  Returns a paginated list of volunteer registrations. Results can be sorted by various fields. Supports full-text search via PostgreSQL GIN index.
  
  ## Authorization
  Requires 'read' permission
  
  ## Query Parameters
  
  | Parameter | Type   | Required | Default     | Description / Allowed Values                                                                                                                  |
  |-----------|--------|----------|-------------|-----------------------------------------------------------------------------------------------------------------------------------------------|
  | page      | number | No       | `1`         | Page number (integer ≥ 1)                                                                                                                     |
  | limit     | number | No       | `25`        | Items per page (integer, 1–100)                                                                                                               |
  | orderBy   | string | No       | `desc`      | Sort direction. One of: `asc`, `desc`                                                                                                         |
  | status    | string | No       | `pending`   | One of: `accepted`, `rejected`, `pending`                                                                                                     |
  | sortBy    | string | No       | `createdAt` | One of: `firstName`, `surname`, `gender`, `emailAddress`, `state`, `availability`, `volunteerAreas`, `createdAt`                               |
  | search    | string | No       | —           | Full-text search query. When provided, cache and sort/status filters are bypassed and results are matched against the GIN index.               |
  
  ### Searchable Fields
  
  | Field                | Weight |
  |----------------------|--------|
  | `firstName`          | A      |
  | `surname`            | A      |
  | `emailAddress`       | A      |
  | `phoneNumber`        | B      |
  | `state`              | B      |
  | `volunteerAreas`     | C      |
  | `skillsToContribute` | C      |
  | `ashExtracurricular` | C      |
  
  ## Response
  
  **`200 OK`** — Returns a paginated array of volunteer registration records.
  
  ```json
  {
    "success": true,
    "data": [ ... ],
    "meta": {
      "pagination": {
        "page": 1,
        "limit": 25,
        "totalPages": 2
      },
      "metadata": {
        "totalSubmissions": 40,
        "acceptedStudents": 10,
        "rejectedStudents": 10,
        "pendingStudents": 20
      },
      "correlationId": "uuid-v4-string"
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                           |
  |-----------------------------|-------------------------------------------------------|
  | `400 Bad Request`           | Invalid query parameters (e.g. unknown `sortBy` key). |
  | `500 Internal Server Error` | Unexpected server error.                              |
}
