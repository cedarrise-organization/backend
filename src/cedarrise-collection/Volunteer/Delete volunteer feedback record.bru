meta {
  name: Delete volunteer feedback record
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/v1/volunteer/feedback/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: 342d7b39-abf1-464e-ab5e-2c9810e6fac3
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Delete Volunteer Feedback Record
  
  Permanently deletes a single volunteer feedback record by its unique identifier. The corresponding cache entry is also invalidated.
  
  ## Authorization
  Requires `delete` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                                |
  |-----------|--------|----------|--------------------------------------------|
  | id        | string | Yes      | UUID of the volunteer feedback record      |
  
  ## Response
  
  **`200 OK`** — Confirms the volunteer feedback record has been deleted.
  
  ```json
  {
    "success": true,
    "message": "...",
    "data": null,
    "meta": {
      "correlationId": "uuid-v4-string"
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                             |
  |-----------------------------|---------------------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format (must be a valid UUID).              |
  | `401 Unauthorized`          | Missing or invalid authentication token.                |
  | `403 Forbidden`             | User does not have `delete` permission.                 |
  | `500 Internal Server Error` | Unexpected server error.                                |
}
