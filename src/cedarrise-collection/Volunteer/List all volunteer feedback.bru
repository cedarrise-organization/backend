meta {
  name: List all volunteer feedback
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/volunteer/all/feedback?page=&limit=
  body: none
  auth: inherit
}

params:query {
  page: 
  limit: 
}

vars:pre-request {
