  url: {{baseUrl}}/api/v1/forms/tacots/onboarding/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: 31aa62bd-73d7-4df0-858f-c9d0cf8601ff
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get TACOTS Onboarding Detail
  
  Retrieves the full detail of a single TACOTS onboarding record by its unique identifier. Returns all mental-health screening, physical-health, enrolled school, commitment, and file URL fields.
  
  ## Authorization
  Requires `read` permission.
  
  ## Path Parameters
  
  | Parameter | Type   | Required | Description                            |
  |-----------|--------|----------|----------------------------------------|
  | id        | string | Yes      | UUID of the TACOTS onboarding record   |
  
  ## Response
  
  **`200 OK`** — Returns the complete TACOTS onboarding record including all uploaded file URLs.
  
  ## Errors
  
  | Status                      | Description                                             |
  |-----------------------------|---------------------------------------------------------|
  | `400 Bad Request`           | Invalid `id` format (must be a valid UUID).              |
  | `401 Unauthorized`          | Missing or invalid authentication token.                |
  | `403 Forbidden`             | User does not have `read` permission.                   |
  | `500 Internal Server Error` | Unexpected server error.                                |
}
