meta {
  name: Get TACOTS onboarding detail
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/forms/tacots/onboarding/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  id: e5d6b085-91a3-44c6-b44b-a20c1566b7d4
