meta {
  name: List all recommendations
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/forms/tacots/recommendation?page=&limit=&orderBy=&status=&sortBy=&search=
  body: none
  auth: inherit
}

params:query {
  page: 
  limit: 
  orderBy: 
  status: 
  sortBy: 
  search: 
}

vars:pre-request {
  baseUrl: http://localhost:3000
  page: 
  status: 
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List All TACOTS Recommendations
  
  Returns a paginated list of TACOTS scholarship recommendation submissions. Results can be filtered by admin selection status and sorted by various fields. Supports full-text search via PostgreSQL GIN index.
  
  ## Authorization
  Requires `read` permission.
  
  ## Query Parameters
  
  | Parameter | Type   | Required | Default        | Description / Allowed Values                                                                                            |
  |-----------|--------|----------|----------------|-------------------------------------------------------------------------------------------------------------------------|
  | page      | number | No       | `1`            | Page number (integer ≥ 1)                                                                                               |
  | limit     | number | No       | `25`           | Items per page (integer, 1–100)                                                                                         |
  | orderBy   | string | No       | `desc`         | Sort direction. One of: `asc`, `desc`                                                                                   |
  | status    | string | No       | `KEEP IN VIEW` | One of: `NOT SELECTED`, `KEEP IN VIEW`, `SELECTED`                                                                      |
  | sortBy    | string | No       | `createdAt`    | One of: `firstName`, `surname`, `gender`, `schoolName`, `lastClass`, `createdAt`                                        |
  | search    | string | No       | —              | Full-text search query. When provided, cache and sort/status filters are bypassed and results are matched against the GIN index. |
  
  ### Searchable Fields
  
  | Field                    | Weight |
  |--------------------------|--------|
  | `firstName`              | A      |
  | `surname`                | A      |
  | `stateOfOrigin`          | B      |
  | `lga`                    | B      |
  | `schoolName`             | B      |
  | `lastClass`              | C      |
  | `recommenderFirstName`   | C      |
  | `recommenderLastName`    | C      |
  | `incomeSources`          | D      |
  | `catholicSacraments`     | D      |
  | `supportTypesNeeded`     | D      |
  
  ## Response
  
  **`200 OK`** — Returns a paginated array of TACOTS recommendation records.
  
 ```json
  {
    "success": true,
    "data": [
      {
        "id": "uuid",
        "firstName": "string",
        "middleName": "string" | null,
        "surname": "string",
        "gender": "MALE | FEMALE",
        "age": 14,
        "dob": "YYYY-MM-DD",
        "religion": "string",
        "catholicSacraments": ["string"] | null,
        "parishAttended": "string" | null,
        "diocese": "string" | null,
        "primaryLanguage": "string",
        "phoneNumber": "string" | null,
        "nationality": "string",
        "stateOfOrigin": "string",
        "lga": "string",
        "homeAddress": "string",
        "schoolName": "string",
        "schoolTown": "string",
        "schoolState": "string",
        "lastYearAttended": 2025,
        "lastClass": "string",
        "classPositionLastTerm": "string",
        "lastTermAverage": 72.5 | null,
        "passportPhotoUrl": "string",
        "passportPhotoPublicId": "string",
        "lastResultUrl": "string",
        "lastResultPublicId": "string",
        "fathersName": "string",
        "fathersOccupation": "string",
        "fathersPhone": "string",
        "mothersName": "string",
        "mothersOccupation": "string",
        "mothersPhone": "string",
        "parentsAddress": "string",
        "guardianName": "string" | null,
        "guardianPhone": "string" | null,
        "guardianRelationship": "string" | null,
        "guardianOccupation": "string" | null,
        "guardianAddress": "string" | null,
        "householdSize": 5,
        "numSiblings": 3,
        "familyPosition": "string",
        "specialCircumstances": "string",
        "annualHouseholdIncome": "string",
        "incomeSources": ["string"],
        "numIncomeEarners": "string",
        "avgMonthlyIncome": 45000 | null,
        "livesWith": "string",
        "residenceType": "string",
        "hasElectricity": "string",
        "recommenderFirstName": "string",
        "recommenderLastName": "string",
        "recommenderPhone": "string",
        "recommenderAddress": "string",
        "childBackgroundNotes": "string",
        "supportTypesNeeded": ["string"],
        "otherImportantInfo": "string" | null,
        "disciplineRating": 4,
        "responsibilityRating": 3,
        "careerGoal": "string",
        "studentStatement": "string" | null,
        "declarationConfirmed": true,
        "adminStatus": "NOT SELECTED | KEEP IN VIEW | SELECTED",
        "updatedAt": "ISO 8601" | null,
        "createdAt": "ISO 8601",
        "deletedAt": "ISO 8601" | null
      }
    ],
    "meta": {
      "pagination": {
        "page": 1,
        "limit": 25,
        "totalPages": 1
      }
      "metadata": {
        "totalSubmissions": 40,
        "acceptedStudents": 10,
        "rejectedStudents": 10,
        "pendingStudents": 20
      }
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                           |
  |-----------------------------|-------------------------------------------------------|
  | `400 Bad Request`           | Invalid query parameters (e.g. unknown `sortBy` key). |
  | `500 Internal Server Error` | Unexpected server error.                              |
}
