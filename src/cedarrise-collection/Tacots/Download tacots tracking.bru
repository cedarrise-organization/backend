meta {
  name: Download TACOTS tracking
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v1/forms/tacots/download/tacotstracking
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Download TACOTS Tracking (CSV Export)
  
  Exports the entire `tacots_tracking` table as a CSV file download. Selects all rows (no filters, no pagination) and converts to CSV via `json2csv`. The response is a `text/csv` attachment — **not** JSON.
  
  ## Authorization
  Requires `authenticate()` and `authorize("read")`.
  
  ## Request
  No path parameters, query parameters, or request body.
  
  ## Response — `200 OK`
  
  **Content-Type:** `text/csv`
  **Content-Disposition:** `attachment; filename="tacots_tracking.csv"`
  
  CSV columns (in order): `id`, `studentId`, `schoolId`, `region`, `academicSession`, `academicTerm`, `assessmentPeriod`, `submissionDate`, `highestSubjectScore`, `lowestSubjectScore`, `studentAveragePct`, `studentPositionInClass`, `termResultUrl`, `termResultPublicId`, `academicComment`, `socialBehaviorRating`, `schoolRulesRating`, `responsibilityRating`, `formationComments`, `mentorName`, `mentorshipSessionDate`, `mentorshipMode`, `mentorshipDuration`, `mentorshipNotes`, `serviceActivityType`, `serviceDate`, `serviceDuration`, `serviceDescription`, `serviceSupervisor`, `tuitionFeePaid`, `resourcesSpent`, `sundriesSpent`, `totalAmountSpent`, `paymentEvidenceUrl`, `paymentEvidencePublicId`, `financialNotes`, `updatedAt`, `createdAt`, `deletedAt`.
  
  ## Errors
  
  | Status | Description |
  |--------|-------------|
  | `401 Unauthorized` | Missing or invalid access token / refresh token. |
  | `403 Forbidden` | User lacks the `"read"` permission. |
  | `500 Internal Server Error` | Unexpected server error. |
}
