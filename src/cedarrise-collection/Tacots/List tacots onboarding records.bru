}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List TACOTS Onboarding Records
  
  Returns a paginated list of TACOTS beneficiary onboarding records, ordered by creation date. Supports full-text search via PostgreSQL GIN index.
  
  ## Authorization
  Requires `read` permission.
  
  ## Query Parameters
  
  | Parameter | Type   | Required | Default     | Description / Allowed Values                                                                                          |
  |-----------|--------|----------|-------------|-----------------------------------------------------------------------------------------------------------------------|
  | page      | number | No       | `1`         | Page number (integer ≥ 1)                                                                                             |
  | limit     | number | No       | `25`        | Items per page (integer, 1–100)                                                                                       |
  | orderBy   | string | No       | `desc`      | Sort direction. One of: `asc`, `desc`                                                                                 |
  | sortBy    | string | No       | `createdAt` | One of: `onboardingDate`, `generalHealthStatus`, `enrolledSchoolName`, `enrolledSchoolState`, `enrolledClass`, `createdAt` |
  | search    | string | No       | —           | Full-text search query. When provided, cache and sort filters are bypassed and results are matched against the GIN index. |
  
  ### Searchable Fields
  
  | Field                  | Weight |
  |------------------------|--------|
  | `enrolledSchoolName`   | A      |
  | `enrolledSchoolState`  | A      |
  | `mentorName`           | B      |
  | `sponsorName`          | B      |
  | `generalHealthStatus`  | C      |
  | `enrolledClass`        | C      |
  | `diagnosedConditions`  | D      |
  | `behavioralIndicators` | D      |
  | `chronicConditions`    | D      |
  | `allergies`            | D      |
  | `supportTypesApproved` | D      |
  
  ## Response
  
  **`200 OK`** — Returns a paginated array of TACOTS onboarding records. Each item includes `firstName` and `surname` from the joined TACOTS recommendation record.
  
  ```json
  {
    "success": true,
    "data": [
      {
        "firstName": "string",
        "surname": "string",
        "id": "uuid",
        "studentId": "uuid",
        "onboardingDate": "YYYY-MM-DD",
        "hasMentalHealthDiagnosis": "string",
        "diagnosedConditions": ["string"] | null,
        "behavioralIndicators": ["string"],
        "focusAbilityRating": 3,
        "emotionalStabilityRating": 4,
        "peerInteractionRating": 3,
        "receivedCounseling": "string",
        "needsSpecialSupport": "string",
        "mentalHealthNotes": "string" | null,
        "generalHealthStatus": "string",
        "immunizationStatus": "string",
        "hasChronicCondition": "string",
        "chronicConditions": ["string"] | null,
        "allergies": ["string"],
        "requiresMedication": "string",
        "physicalActivityLevel": 4,
        "physicalLimitations": "string",
        "additionalHealthNotes": "string" | null,
        "enrolledSchoolName": "string",
        "enrolledSchoolTown": "string",
        "enrolledSchoolLga": "string",
        "enrolledSchoolState": "string",
        "enrolledClass": "string",
        "termResumptionDate": "YYYY-MM-DD",
        "schoolFeesPerTerm": 50000 | null,
        "studentCommitment": true | null,
        "parentGuardianCommitment": true,
        "parentSignatureUrl": "string" | null,
        "parentSignaturePublicId": "string" | null,
        "admissionLetterUrl": "string" | null,
        "admissionLetterPublicId": "string" | null,
        "programOfficerNotes": "string" | null,
        "supportTypesApproved": ["string"] | null,
        "mentorName": "string" | null,
        "sponsorName": "string" | null,
        "additionalInfo": "string" | null,
        "updatedAt": "ISO 8601" | null,
        "createdAt": "ISO 8601",
        "deletedAt": "ISO 8601" | null
      }
    ],
    "meta": {
      "pagination": {
        "page": 1,
        "limit": 25,
        "totalPages": 1
      }
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                         |
  |-----------------------------|-----------------------------------------------------|
  | `400 Bad Request`           | Invalid query parameters (e.g. non-numeric `page`). |
  | `401 Unauthorized`          | Missing or invalid authentication token.            |
  | `403 Forbidden`             | User does not have `read` permission.               |
  | `500 Internal Server Error` | Unexpected server error.                            |
}
