meta {
  name: Submit TACOTS Feedback
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/forms/tacots/feedback
  body: json
  auth: inherit
}

body:json {
  {
    "studentFirstName": "Max",
    "studentSurname": "Ogb",
    "currentSchool": "Naim Academy",
    "currentClass": "SS1",
    "scholarshipHelpedStay": "YES - VERY MUCH",
    "mostHelpfulSupport": ["TUITION SUPPORT", "MENTORSHIP"],
    "studyMotivationRating": 4,
    "mentorshipImpactRating": 5,
    "currentChallenges": ["DIFFICULTY UNDERSTANDING SUBJECTS"],
    "likedMost": "",
    "studentImprovementSuggestions": "",
