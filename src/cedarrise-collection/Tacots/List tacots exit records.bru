  sortBy: 
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List TACOTS Exit Records
  
  Returns a paginated list of TACOTS exit/completion records, ordered by creation date. Supports full-text search via PostgreSQL GIN index.
  
  ## Authorization
  Requires `read` permission.
  
  ## Query Parameters
  
  | Parameter | Type   | Required | Default     | Description / Allowed Values                                                                                          |
  |-----------|--------|----------|-------------|-----------------------------------------------------------------------------------------------------------------------|
  | page      | number | No       | `1`         | Page number (integer >= 1)                                                                                            |
  | limit     | number | No       | `25`        | Items per page (integer, 1-100)                                                                                       |
  | orderBy   | string | No       | `desc`      | Sort direction. One of: `asc`, `desc`                                                                                 |
  | sortBy    | string | No       | `createdAt` | One of: `schoolAttendedDuringProgram`, `yearOfExit`, `exitReason`, `createdAt`                                        |
  | search    | string | No       | —           | Full-text search query. When provided, cache and sort filters are bypassed and results are matched against the GIN index. |
  
  ### Searchable Fields
  
  | Field                          | Weight |
  |--------------------------------|--------|
  | `schoolAttendedDuringProgram`  | A      |
  | `exitReason`                   | C      |
  | `currentStatus`                | C      |
  | `completedBy`                  | C      |
  
  ## Response
  
  **`200 OK`** — Returns a paginated array of TACOTS exit records. Each item includes `firstName` and `surname` joined from the TACOTS recommendation record via the onboarding link.
  
  ```json
  {
    "success": true,
    "data": [
      {
        "firstName": "string",
        "surname": "string",
        "id": "uuid",
        "studentId": "uuid",
        "schoolAttendedDuringProgram": "string",
        "yearOfExit": 2026,
        "exitReason": "string",
        "highestEducationAttained": "string",
        "currentStatus": "string",
        "higherInstitutionName": "string" | null,
        "higherInstitutionCity": "string" | null,
        "higherInstitutionState": "string" | null,
        "employmentType": "string" | null,
        "vocationalSkill": "string" | null,
        "newSchoolName": "string" | null,
        "completedSecondaryElsewhere": "string" | null,
        "programImpactDescription": "string" | null,
        "programImpactRating": 8 | null,
        "additionalSituationInfo": "string" | null,
        "completedBy": "string",
        "submissionDate": "YYYY-MM-DD",
        "updatedAt": "ISO 8601" | null,
        "createdAt": "ISO 8601",
        "deletedAt": "ISO 8601" | null
      }
    ],
    "meta": {
      "pagination": {
        "page": 1,
        "limit": 25,
        "totalPages": 1
      }
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                         |
  |-----------------------------|-----------------------------------------------------|
  | `400 Bad Request`           | Invalid query parameters (e.g. non-numeric `page`). |
  | `401 Unauthorized`          | Missing or invalid authentication token.            |
  | `403 Forbidden`             | User does not have `read` permission.               |
  | `500 Internal Server Error` | Unexpected server error.                            |
}
