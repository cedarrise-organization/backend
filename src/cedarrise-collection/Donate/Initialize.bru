meta {
  name: Initialize
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/donate
  body: json
  auth: inherit
}

body:json {
  {
    "amount": 10,
    "email": "maximilianogbuabor@gmail.com",
    "name": "max",
    "comment": "Love your work"
  }
}

body:form-urlencoded {
  amount: 10
  name: Max
  comment: Love your work
  email: omaxksultan@gmail.com
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}
