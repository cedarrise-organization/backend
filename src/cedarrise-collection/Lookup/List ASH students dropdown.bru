meta {
  name: List ASH students dropdown
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/lookup/ash-students
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List ASH Students Dropdown

  Returns a lightweight list of accepted ASH students for use in dropdown/select components. Each entry contains only the student `id` and `name` (first name).

  ## Authorization
  No authentication required. This is a public lookup endpoint.

  ## Response

  **`200 OK`** — Returns an array of `{ id, name }` objects for accepted ASH students.

  ```json
  {
    "success": true,
    "message": "students found successfully",
    "data": [
      { "id": "uuid", "name": "John" }
    ]
  }
  ```

  ## Caching
  Response is cached under `cedarrise:lookup:ash` with `LISTS` TTL (10 mins).

  ## Errors

  | Status                      | Description              |
  |-----------------------------|--------------------------|
  | `500 Internal Server Error` | Unexpected server error. |
}
