meta {
  name: Upload google form
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/general/google-forms
  body: json
  auth: inherit
}

body:json {
  {
    "url": "https://docs.google.com/forms/d/e/1FAIpQLSf...",
    "title": "Volunteer Registration Form",
    "description": "Form for volunteering registration 2026",
    "deadline": "2026-06-30"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Upload Google Form Link
  
  Creates a new Google Form record in the database with a title, iframe source link, description, and active deadline.
  
  ## Authorization
  
  - **Authentication:** Required — Bearer token via `authenticate()`.
  - **Permission:** `create` — enforced by `authorize("create")`.
  
  ## Request
  
  **Content-Type:** `application/json`
  
  ### Body Fields
  
  | Field         | Type   | Required | Validation                                                   |
  |---------------|--------|----------|--------------------------------------------------------------|
  | `url`         | string | ✅       | The iframe embed link or source URL for the form.            |
  | `title`       | string | ✅       | Min 3 characters, max 100 characters.                        |
  | `description` | string | ❌       | Optional description of the form.                            |
  | `deadline`    | string | ✅       | ISO 8601 Date string (e.g. `YYYY-MM-DD`).                    |
  
  ## Response
  
  **`201 Created`** — Returns the created Google Form details.
  
  ```json
  {
    "success": true,
    "message": "Form Link Uploaded successfully",
    "data": {
      "id": "2d8f99e4-8c81-4b1f-bc80-d2cf2e09ff7b",
      "title": "Volunteer Registration Form",
      "src": "https://docs.google.com/forms/d/e/1FAIpQLSf...",
      "description": "Form for volunteering registration 2026",
      "deadline": "2026-06-30T00:00:00.000Z",
      "createdAt": "2026-06-18T10:22:47.000Z"
    }
  }
  ```
  
  ## Errors
  
  | Status                      | Description                                                             |
  |-----------------------------|-------------------------------------------------------------------------|
  | `400 Bad Request`           | Validation failed (e.g. title too short, invalid date format).          |
  | `401 Unauthorized`          | Missing or invalid Bearer token.                                        |
  | `403 Forbidden`             | Insufficient permissions.                                               |
  | `500 Internal Server Error` | Unexpected server error.                                                |
}
