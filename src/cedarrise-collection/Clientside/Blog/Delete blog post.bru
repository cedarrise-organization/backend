meta {
  name: Delete blog post
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/blogs/{{id}}
  body: none
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
  id: 5f218adc-60b1-4ed2-a70f-74eec261c8f1
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Delete Blog Post
  
  Permanently deletes a blog post and its associated document from Cloudinary.
  
  ## Endpoint
  `DELETE /api/v1/blogs/:id`
  
  ## Authorization
  Inherited — requires authentication.
  
  ## Path Parameters
  
  | Param | Type   | Required | Constraints | Description                    |
  | :---- | :----- | :------- | :---------- | :----------------------------- |
  | id    | string | Yes      | Valid UUID   | The unique ID of the blog post. |
  
  ## Success Response
  - **Status Code**: `200 OK`
  - **Body**:
    ```json
    {
      "success": true,
      "message": "Blog deleted successfully",
      "data": null
    }
    ```
  
  ## Error Responses
  - **400 Bad Request**: Validation failed (e.g., `id` is not a valid UUID).
  - **500 Internal Server Error**: Blog not found.
  
  ## Notes
  - The associated document is deleted from Cloudinary before the database row is removed.
  - The cache entry `cedarrise:blogs:single:{id}` is invalidated after deletion.
}
