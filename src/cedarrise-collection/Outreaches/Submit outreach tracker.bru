meta {
  name: Submit outreach tracker
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/forms/outreaches
  body: json
  auth: inherit
}

body:json {
  {
    "outreachStartDate": "2026-03-01",
    "outreachEndDate": "2026-03-05",
    "outreachState": "LAGOS",
    "outreachLga": "ikeja",
    "outreachCity": "ikeja",
    "outreachCommunity": "alausa community",
    "numVolunteers": 12,
    "numBeneficiaries": 85,
    "outreachType": ["EDUCATIONAL", "SOFT SKILLS"],
