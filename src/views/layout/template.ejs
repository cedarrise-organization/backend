<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://kit.fontawesome.com/5e2b46074f.js" crossorigin="anonymous"></script>
    <title><%= subject %></title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #f5f5f5;
      font-family: Arial, Helvetica, sans-serif;
      color: #1b1b1e;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background: #f5f5f5; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="background: #ffffff; border-radius: 8px; overflow: hidden"
          >
            <!-- Header -->
            <tr>
              <td align="center" style="padding: 20px 10px; border-bottom: 4px solid #faa916">
                <img src="<%=logourl%>" alt="Logo" width="60" style="display: block" />
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td style="padding: 40px 40px 20px">
                <h1 style="margin: 0; color: #1b1b1e; font-size: 26px; font-weight: bold">
                  <%= title %>
                </h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 0 40px 40px; font-size: 16px; line-height: 1.8; color: #1b1b1e">
                <%- content %>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
            <td
              style="
                background: #ffffff;
                color: #1b1b1e;
                padding: 30px 40px;
                border-top: 4px solid #faa916;
              "
            >
              <p style="text-align: center; margin: 0">
                <a
                  href="tel:+2349039377669"
                  style="text-decoration: none; margin-right: 16px"
                >
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=9659&format=png&color=000000"
                    alt="Phone"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>

                <a
                  href="https://www.instagram.com/cedarriseinitiative/"
                  style="text-decoration: none; margin-right: 16px"
                >
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=32292&format=png&color=000000"
                    alt="Instagram"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>

                <a href="https://www.linkedin.com/company/cedarrise-initiative/" style="text-decoration: none; margin-right: 16px">
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=447&format=png&color=000000"
                    alt="LinkedIn"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>

                <a
                  href="https://cedarrise.org"
                  style="text-decoration: none; margin-right: 16px"
                >
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=1349&format=png&color=000000"
                    alt="Website"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>

                <a href="https://wa.me/2349039377669" style="text-decoration: none; margin-right: 16px">
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=16712&format=png&color=000000"
                    alt="WhatsApp"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>

                <a
                  href="https://youtube.com/@cedarriseinitiative?si=egOoQo2F-UL02K3N"
                  style="text-decoration: none; margin-right: 16px"
                >
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=37325&format=png&color=000000"
                    alt="YouTube"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>

                <a
                  href="https://www.tiktok.com/@cedarrise.initiat?_r=1&_t=ZS-91xutUBqFZx"
                  style="text-decoration: none"
                >
                  <img
                    width="20"
                    height="20"
                    src="https://img.icons8.com/?size=100&id=84521&format=png&color=000000"
                    alt="TikTok"
                    style="display: inline-block; vertical-align: middle"
                  />
                </a>
              </p>

              <hr style="border: none; border-top: 1px solid #444; margin: 20px 0" />

              <p align="center" style="margin: 0; font-size: 12px; color: #000000">
                © <%= new Date().getFullYear() %> Cedarrise. All rights reserved.
                <br />SouthEast Nigeria
              </p>
            </td>
          </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
